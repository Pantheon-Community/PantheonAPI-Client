{
    "private": true,
    "type": "module",
    "scripts": {
        "dev": "bun --hot src/index.ts",
        "build": "bun build ./src/index.html --outdir=dist --sourcemap --target=browser --minify --define:process.env.NODE_ENV='\"production\"' --env='BUN_PUBLIC_*'",
        "start": "NODE_ENV=production bun src/index.ts",
        "lint": "biome check",
        "lint-fix": "biome check --write",
        "typecheck": "bun run tsc --project tsconfig.json",
        "check-all": "bun run lint && bun run typecheck"
    },
    "dependencies": {
        "dayjs": "^1.11.19",
        "highlight.js": "^11.11.1",
        "react": "^19",
        "react-dom": "^19",
        "react-router": "^7.13.1"
    },
    "devDependencies": {
        "@biomejs/biome": "^2.4.4",
        "@types/bun": "latest",
        "@types/react": "^19",
        "@types/react-dom": "^19",
        "typescript": "^5.9.3"
    }
}
